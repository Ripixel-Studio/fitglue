# ~/.jarvis/fitglue.env — secrets and per-box settings for the FitGlue units.
# deploy/box/*.service load it with EnvironmentFile=; chmod 600 it.
#
# Format is systemd's, not shell: KEY=value, one per line, NO inline comments
# (everything after = is the value, '#' included), no quoting needed unless
# the value has spaces. A line `KEY=` sets KEY to the empty string, which the
# services treat as unset. A key set here overrides the same key in a unit.
#
# F3.5 writes the real file from Secret Manager. Every key the Go services
# read that is not fixed in a unit file is listed. Deployment-fixed,
# non-secret settings are in the units instead: PORT, SERVICE_NAME,
# *_SERVICE_URL, PROJECT_ID, GOOGLE_CLOUD_PROJECT, ENVIRONMENT, LOG_LEVEL,
# GCP_REGION, ARTIFACT_BUCKET, GCS_ARTIFACT_BUCKET, SHOWCASE_ASSETS_BUCKET,
# ASSETS_BASE_URL, SITE_EXPORT_SLUG, GOOGLE_APPLICATION_CREDENTIALS.

# ── The one user (api-client) ─────────────────────────────────────────────
# Static bearer token; Secret Manager `fitglue-api-token`.
FITGLUE_API_TOKEN=
# Firestore users/{uid} of the owner; terraform `owner_uid`.
FITGLUE_OWNER_UID=

# ── Pub/Sub push verification (pipeline, activity, destination) ───────────
# Unset = no in-process check (on Cloud Run, IAM did it). On the box it MUST
# be set: the push endpoints are reachable from the internet via Funnel.
# terraform/pubsub.tf (F3.4) sets `oidc_token { audience = local.box_pubsub_audience }`
# on every push subscription; this value must be byte-for-byte the same:
#   PUBSUB_PUSH_AUDIENCE=https://jarvis.tail3065f7.ts.net/fg/pubsub
# (deploy/box/cutover.sh --check fails if it differs.)
PUBSUB_PUSH_AUDIENCE=https://jarvis.tail3065f7.ts.net/fg/pubsub
# Optional: also require the token's verified email claim to be this service
# account (the subscriptions' oidc_token.service_account_email). The push
# subscriptions sign with the per-service cr-<svc>-sa accounts (F3.2 kept it
# that way; fitglue-box is not involved), so a single value here cannot fit
# all three services — leave unset, or set it per unit with a drop-in.
PUBSUB_PUSH_SERVICE_ACCOUNT=

# ── OAuth (api-client) ────────────────────────────────────────────────────
# HMAC key for the OAuth state parameter.
OAUTH_STATE_SECRET=
# Public base URL providers redirect back to (F2.3, internal/oauthflow):
# the callback is <base>/api/v2/oauth/<provider>/callback. On the box that is
# https://jarvis.tail3065f7.ts.net/fg/oauth/<provider>/callback via Caddy
# (F3.3), so set the base so that it maps there — see docs/guides/box-ingress.md
# and connect-sources.md. Required: api-client panics on the first OAuth
# request with neither this nor API_URL set.
FITGLUE_PUBLIC_BASE_URL=
# Legacy fallback for FITGLUE_PUBLIC_BASE_URL; today https://fitglue.tech.
API_URL=
# Where the browser lands after a callback (`/app` is appended).
WEB_URL=

# ── Provider credentials ──────────────────────────────────────────────────
# Who reads what: api-client refreshes tokens for every connected provider
# (<PROVIDER>_CLIENT_ID / _CLIENT_SECRET looked up by name), destination
# refreshes on upload, api-webhook verifies pushes, pipeline runs the
# heart-rate (Google Health) and Spotify enrichers.
# pipeline AI enrichers + activity roundup summary
GEMINI_API_KEY=
# Google Health API OAuth client (Web application, project fitglue-server-prod):
# heart rate today, sleep/body/food next. Redirect URI registered on it:
# https://jarvis.tail3065f7.ts.net/fg/api/v2/oauth/googlehealth/callback
GOOGLEHEALTH_CLIENT_ID=
GOOGLEHEALTH_CLIENT_SECRET=
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# api-webhook
STRAVA_WEBHOOK_VERIFY_TOKEN=
# Fitbit: legacy, turned off 2 Nov 2026; only the Fitbit activity source still
# reads these (connect-sources.md § Fitbit lists what goes with it).
FITBIT_CLIENT_ID=
FITBIT_CLIENT_SECRET=
# api-webhook reads this name for the Fitbit signature check; same value as
# FITBIT_CLIENT_SECRET.
FITBIT_OAUTH_CLIENT_SECRET=
# api-webhook
FITBIT_SUBSCRIBER_VERIFICATION_TOKEN=
TRAININGPEAKS_CLIENT_ID=
TRAININGPEAKS_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# api-webhook
GITHUB_WEBHOOK_SECRET=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Only if the Google Sheets destination is still in use.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ── Optional ──────────────────────────────────────────────────────────────
# Unset = Sentry off.
SENTRY_DSN=
# Release tag for Sentry; Cloud Run used K_REVISION, the box has nothing.
# SENTRY_RELEASE=
# Cloud Run Playwright fetcher; unset = direct fetch (WAF-walled either way).
# The box parkrun agent is the real path; F4 deletes the fetcher.
# PARKRUN_FETCHER_URL=
# Site export on change (S1.2, activity service, docs/guides/site-export.md).
# SITE_EXPORT_SLUG=james is in the unit. POSTed after every index refresh —
# the box-side hook that rebuilds the site; set on the box only.
SITE_EXPORT_HOOK_URL=
# Destination bucket; unset = SHOWCASE_ASSETS_BUCKET.
# SITE_EXPORT_BUCKET=
# 1/true/yes turns the export hook off entirely.
# SITE_EXPORT_DISABLED=
