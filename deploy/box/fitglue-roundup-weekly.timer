# Same schedule as the Cloud Scheduler job it replaces (weekly-roundup-generator).
# Persistent= fires a missed run at the next boot/login, as Scheduler's retry did.
[Unit]
Description=FitGlue weekly roundup trigger timer
PartOf=fitglue.target

[Timer]
OnCalendar=Mon *-*-* 06:00:00 UTC
Persistent=true
RandomizedDelaySec=60
Unit=fitglue-roundup-weekly.service

[Install]
WantedBy=timers.target
