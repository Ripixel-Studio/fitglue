# FitGlue destination on the Jarvis box (rethink F3.1). Installed by deploy/box/install.sh
# as a symlink into ~/.config/systemd/user/; started via fitglue.target.
# Non-secret, deployment-fixed settings live here. Secrets and per-box values
# come from ~/.jarvis/fitglue.env (see fitglue.env.example), which overrides
# anything set below.
[Unit]
Description=FitGlue destination service (Pub/Sub push: uploads)
After=network-online.target fitglue-user.service fitglue-activity.service
Wants=network-online.target
PartOf=fitglue.target

[Service]
Type=simple
ExecStart=%h/work/fitglue-server/bin/destination
WorkingDirectory=%h/work/fitglue-server
EnvironmentFile=%h/.jarvis/fitglue.env
Environment=PROJECT_ID=fitglue-server-prod
Environment=GOOGLE_CLOUD_PROJECT=fitglue-server-prod
Environment=ENVIRONMENT=prod
Environment=LOG_LEVEL=info
Environment=GOOGLE_APPLICATION_CREDENTIALS=%h/.jarvis/fitglue-box-sa.json
Environment=SERVICE_NAME=destination
Environment=PORT=8106
Environment=USER_SERVICE_URL=http://127.0.0.1:8103
Environment=ACTIVITY_SERVICE_URL=http://127.0.0.1:8105
Environment=GCS_ARTIFACT_BUCKET=fitglue-server-prod-artifacts
Environment=SHOWCASE_ASSETS_BUCKET=fitglue-server-prod-showcase-assets
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=fitglue-destination
NoNewPrivileges=true
PrivateTmp=true
